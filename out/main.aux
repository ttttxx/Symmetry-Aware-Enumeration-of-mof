\newlabel{sec:searchEC}{{1}{8}{Cross-Validation and Benchmarking against Algebraic Enumeration}{section*.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cross-validation against CASM algebraic enumeration on identical quotient graphs (exhaustive cases).} ``Orbits ($\Gamma $)'' is the proper-rotation count from our enumerator; it equals the CASM full-group count after enantiomer reconciliation ($P=A+2C$) in every row. ``CASM (full grp)'' is the raw count modulo the complete crystallographic factor group, and the undercount is $(P-F_{\mathrm  {total}})/P$, i.e.\ the fraction of physically distinct configurations a full-symmetry substitutional count omits. Times are single-core wall-clock for the enumeration core only (median of three runs); sub-$0.1$\,s values for the Python implementation are startup-dominated and not algorithmically meaningful, and CASM (C++) is faster on these small spaces (see text).}}{9}{table.1}\protected@file@percent }
\newlabel{tab:casm}{{1}{9}{\textbf {Cross-validation against CASM algebraic enumeration on identical quotient graphs (exhaustive cases).} ``Orbits ($\Gamma $)'' is the proper-rotation count from our enumerator; it equals the CASM full-group count after enantiomer reconciliation ($P=A+2C$) in every row. ``CASM (full grp)'' is the raw count modulo the complete crystallographic factor group, and the undercount is $(P-F_{\mathrm {total}})/P$, i.e.\ the fraction of physically distinct configurations a full-symmetry substitutional count omits. Times are single-core wall-clock for the enumeration core only (median of three runs); sub-$0.1$\,s values for the Python implementation are startup-dominated and not algorithmically meaningful, and CASM (C++) is faster on these small spaces (see text)}{table.1}{}}
\newlabel{sec:validation}{{1}{9}{Validation of Geometric Assembly}{section*.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Validation of geometric assembly across diverse representative topologies: (a) \texttt  {ffc}, (b) \texttt  {fjh}, and (c) \texttt  {vba}. The insets highlight the geometric consistency between SBUs and linkers, demonstrating the reliability of the assembly process across different framework architectures.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:reconstruction_gallery}{{2}{9}{Validation of geometric assembly across diverse representative topologies: (a) \texttt {ffc}, (b) \texttt {fjh}, and (c) \texttt {vba}. The insets highlight the geometric consistency between SBUs and linkers, demonstrating the reliability of the assembly process across different framework architectures}{figure.2}{}}

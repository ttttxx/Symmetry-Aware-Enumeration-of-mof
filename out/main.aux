\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pooled \texttt  {ffc} single-point DFT energies classified by fixed Symmetry Index intervals. Low, medium, and high symmetry correspond to $0<\rho \leq 0.25$, $0.25<\rho \leq 0.75$, and $0.75<\rho \leq 1$, respectively. Open circles mark the lowest-energy candidate within each fixed composition. The plot is used as a descriptive screening view rather than as a composition-controlled statistical test.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:ffc_pooled_symmetry}{{3}{11}{Pooled \texttt {ffc} single-point DFT energies classified by fixed Symmetry Index intervals. Low, medium, and high symmetry correspond to $0<\rho \leq 0.25$, $0.25<\rho \leq 0.75$, and $0.75<\rho \leq 1$, respectively. Open circles mark the lowest-energy candidate within each fixed composition. The plot is used as a descriptive screening view rather than as a composition-controlled statistical test}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Composition-controlled relationship between Symmetry Index $\rho (c)$ and DFT energy per atom for the \texttt  {ffc} and \texttt  {fjh} topologies (PBE+D3, CP2K). Each panel is analyzed within fixed chemical compositions, and the trend is assessed using the Spearman rank correlation together with whether the lowest-energy structure falls in the maximum-$\rho $ subset sampled for that composition.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:symmetry_stability}{{4}{11}{Composition-controlled relationship between Symmetry Index $\rho (c)$ and DFT energy per atom for the \texttt {ffc} and \texttt {fjh} topologies (PBE+D3, CP2K). Each panel is analyzed within fixed chemical compositions, and the trend is assessed using the Spearman rank correlation together with whether the lowest-energy structure falls in the maximum-$\rho $ subset sampled for that composition}{figure.4}{}}

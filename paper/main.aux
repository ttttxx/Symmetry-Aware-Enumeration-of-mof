\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cross-validation against CASM algebraic enumeration on identical quotient graphs (exhaustive cases).} ``Orbits ($\Gamma $)'' is the proper-rotation count $P$ from our enumerator. ``CASM (full grp)'' is the raw count $F_{\mathrm  {total}}$ modulo the complete crystallographic factor group; the full-group count is reconciled to the proper-rotation count by $P=A+2C$, and the undercount is $(P-F_{\mathrm  {total}})/P$. Times are single-core wall-clock for the enumeration core only (median of three runs); sub-$0.1$\,s values for the Python implementation are startup-dominated.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:casm}{{1}{10}{\textbf {Cross-validation against CASM algebraic enumeration on identical quotient graphs (exhaustive cases).} ``Orbits ($\Gamma $)'' is the proper-rotation count $P$ from our enumerator. ``CASM (full grp)'' is the raw count $F_{\mathrm {total}}$ modulo the complete crystallographic factor group; the full-group count is reconciled to the proper-rotation count by $P=A+2C$, and the undercount is $(P-F_{\mathrm {total}})/P$. Times are single-core wall-clock for the enumeration core only (median of three runs); sub-$0.1$\,s values for the Python implementation are startup-dominated}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Validation of geometric assembly across representative topologies: (a) \texttt  {ffc}, (b) \texttt  {fjh}, and (c) \texttt  {vba}. Insets show the local coordination regions used for geometric inspection.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:reconstruction_gallery}{{2}{10}{Validation of geometric assembly across representative topologies: (a) \texttt {ffc}, (b) \texttt {fjh}, and (c) \texttt {vba}. Insets show the local coordination regions used for geometric inspection}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Composition-controlled single-point DFT energies classified by fixed Symmetry Index intervals for \texttt  {ffc}. Low, medium, and high symmetry correspond to $0<\rho \leq 0.25$, $0.25<\rho \leq 0.75$, and $0.75<\rho \leq 1$, respectively. Filled circles denote all completed candidates, and open circles mark the lowest-energy candidate within each fixed composition. The open-circle pattern is intended as a qualitative retention check under composition control, not as a formal statistical trend estimate.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:pooled_symmetry_energy}{{3}{11}{Composition-controlled single-point DFT energies classified by fixed Symmetry Index intervals for \texttt {ffc}. Low, medium, and high symmetry correspond to $0<\rho \leq 0.25$, $0.25<\rho \leq 0.75$, and $0.75<\rho \leq 1$, respectively. Filled circles denote all completed candidates, and open circles mark the lowest-energy candidate within each fixed composition. The open-circle pattern is intended as a qualitative retention check under composition control, not as a formal statistical trend estimate}{figure.3}{}}
